{
  "name": "imb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:server:dev\" \"npm:dev\"",
    "seed": "node server/scripts/seed.js",
    "seed:sample": "node server/scripts/seed-sample.js",
    "seed:clothing": "node server/scripts/seed-wholesale-clothing.js",
    "seed:pharmacy": "node server/scripts/seed-pharmacy.js",
    "reset-password": "node server/scripts/reset-password.js",
    "db:check": "node server/scripts/db-check.js",
    "db:check:supabase": "node -e \"import('./server/config/supabase.js').then(m => m.testSupabaseConnection()).then(r => { console.log(r); process.exit(0); })\"",
    "db:migrate:supabase": "node server/scripts/migrate-mongo-to-supabase.js",
    "seed:supabase": "node server/scripts/seed-supabase.js",
    "build": "vite build",
    "lint": "oxlint",
    "ui:check": "node scripts/ui-check.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "motion": "^13.2.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "oxlint": "^1.79.0",
    "playwright": "^1.64.1",
    "vite": "^8.2.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
